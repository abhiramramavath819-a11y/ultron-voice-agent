# ---- Required --------------------------------------------------------------
# The reasoning core. Free tier available at https://aistudio.google.com/apikey
# Gemini keys begin with "AIza".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Optional: other providers ---------------------------------------------
# GEMINI_API_KEY wins when several are set, so these need LLM_PROVIDER to apply.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# LLM_PROVIDER=openai

# ---- Optional: natural voices ----------------------------------------------
# Without a key the browser's own synthesizer is used. It works everywhere and
# still applies each persona's pitch and rate, but it sounds robotic.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_FRIDAY=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_JARVIS=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_ULTRON=pNInz6obpgDQGcFmaJgB

# ---- Optional: persistence -------------------------------------------------
# Vercel Postgres sets this when you attach a store. Run `npm run migrate` after.
# Without it the app runs fine, memory-only.
DATABASE_URL=

# ---- Testing ---------------------------------------------------------------
# Point a provider at a mock server. Leave unset in production.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/MODEL:streamGenerateContent
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
