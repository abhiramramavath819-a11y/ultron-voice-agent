:root {
    --bg-base: #020000;
    --red-main: #ff1111;
    --red-dim: #550000;
    --red-glow: rgba(255, 17, 17, 0.6);
    --grid-color: rgba(255, 17, 17, 0.1);
    --panel-bg: rgba(15, 0, 0, 0.7);
    --panel-border: rgba(255, 17, 17, 0.3);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-base);
    color: var(--red-main);
    font-family: 'Share Tech Mono', monospace;
    height: 100vh;
    overflow: hidden;
    position: relative;
    /* Grid background */
    background-image: 
        linear-gradient(var(--grid-color) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
    background-size: 30px 30px;
}

/* Scanlines overlay */
.scanlines {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2));
    background-size: 100% 4px;
    z-index: 999;
    pointer-events: none;
    opacity: 0.3;
}

/* Overall Container */
.hud-container {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    height: 100vh;
    padding: 20px;
}

/* Header */
.hud-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--red-main);
    padding-bottom: 10px;
    margin-bottom: 20px;
}

.sys-info {
    display: flex;
    flex-direction: column;
    font-size: 0.8rem;
    color: var(--red-dim);
}
.sys-info.right {
    text-align: right;
}

h1.glitch {
    font-family: 'Orbitron', sans-serif;
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: 15px;
    color: var(--red-main);
    text-shadow: 0 0 10px var(--red-main);
    position: relative;
}

.text-glow-red {
    color: var(--red-main);
    text-shadow: 0 0 8px var(--red-main);
    animation: blink 2s infinite;
}

/* Main Layout */
.hud-main {
    display: flex;
    flex: 1;
    gap: 20px;
    height: calc(100vh - 100px);
}

.panel {
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    backdrop-filter: blur(5px);
    border-radius: 5px;
    box-shadow: inset 0 0 20px rgba(255,0,0,0.05), 0 0 15px rgba(255,0,0,0.1);
    display: flex;
    flex-direction: column;
}

.side-panel {
    width: 250px;
    padding: 15px;
}

.center-panel {
    flex: 1;
    padding: 20px;
    justify-content: flex-end;
}

.panel-header {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--red-dim);
    margin-bottom: 15px;
    padding-bottom: 5px;
    letter-spacing: 2px;
}

/* Left Panel: Data Stream */
.data-stream {
    font-size: 0.85rem;
    line-height: 1.8;
}
.bar-chart {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.bar-chart .bar {
    height: 6px;
    background: var(--red-main);
    box-shadow: 0 0 5px var(--red-main);
}

/* Center Panel: Chat Interface */
.chat-window {
    flex: 1;
    overflow-y: auto;
    margin-bottom: 20px;
    padding-right: 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.chat-window::-webkit-scrollbar {
    width: 5px;
}
.chat-window::-webkit-scrollbar-thumb {
    background: var(--red-dim);
}

.chat-message {
    font-size: 1.1rem;
    line-height: 1.5;
    text-shadow: 0 0 5px var(--red-glow);
    display: flex;
    gap: 10px;
}

.chat-message .sender {
    font-weight: bold;
    color: #fff;
    text-shadow: 0 0 5px #fff;
}

.user-msg .sender {
    color: #888;
    text-shadow: none;
}
.user-msg .message-text {
    color: #ccc;
    text-shadow: none;
}

/* Chat Input */
.input-container {
    display: flex;
    align-items: center;
    border-top: 1px solid var(--red-dim);
    padding-top: 15px;
    gap: 10px;
}
.prompt-arrow {
    font-weight: bold;
    font-size: 1.2rem;
}
#chat-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--red-main);
    font-family: 'Share Tech Mono', monospace;
    font-size: 1.1rem;
    outline: none;
    text-shadow: 0 0 5px var(--red-glow);
}
#chat-input::placeholder {
    color: var(--red-dim);
}
#send-btn {
    background: transparent;
    border: 1px solid var(--red-main);
    color: var(--red-main);
    font-family: 'Orbitron', sans-serif;
    padding: 8px 15px;
    cursor: pointer;
    text-transform: uppercase;
    transition: 0.3s;
}
#send-btn:hover {
    background: var(--red-main);
    color: #000;
    box-shadow: 0 0 15px var(--red-main);
}

/* Right Panel: Reactor Animation */
.reactor-container {
    position: relative;
    width: 150px;
    height: 150px;
    margin: 20px auto;
    display: flex;
    justify-content: center;
    align-items: center;
}
.reactor-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid transparent;
}
.outer-ring {
    width: 100%; height: 100%;
    border-top: 2px solid var(--red-main);
    border-bottom: 2px solid var(--red-main);
    animation: spin 8s linear infinite;
    box-shadow: 0 0 15px var(--red-glow) inset;
}
.middle-ring {
    width: 75%; height: 75%;
    border-left: 2px solid var(--red-main);
    border-right: 2px solid var(--red-main);
    animation: spin-reverse 5s linear infinite;
}
.inner-ring {
    width: 50%; height: 50%;
    border: 1px dashed var(--red-main);
    animation: spin 3s linear infinite;
}
.reactor-core {
    width: 30%; height: 30%;
    background: var(--red-main);
    border-radius: 50%;
    box-shadow: 0 0 20px var(--red-main);
    animation: pulse 2s infinite;
}

.target-data {
    margin-top: 30px;
    font-size: 0.8rem;
    line-height: 1.8;
}

/* Animations */
@keyframes spin {
    100% { transform: rotate(360deg); }
}
@keyframes spin-reverse {
    100% { transform: rotate(-360deg); }
}
@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.1); opacity: 1; }
}
@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}
